# Copy to /opt/flotilla/secrets/lakehouse.env; chmod 600; replace placeholders.
# Generate three separate values with: openssl rand -hex 32
AWS_ACCESS_KEY_ID=replace-with-random-access-key
AWS_SECRET_ACCESS_KEY=replace-with-random-secret
AWS_DEFAULT_REGION=us-east-1
JUPYTER_TOKEN=replace-with-random-token
