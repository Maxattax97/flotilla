# Copy this file to /opt/flotilla/config/borg/entourage.env and edit it.

# Hostname or IP address of the backup repository host.
BORG_BACKUP_HOST=bastion
BORG_BACKUP_USER=borg
BORG_REPO_PATH=/mnt/backup/repos/entourage
BORG_ARCHIVE_PREFIX=entourage

# Secret files are not committed to Git.
BORG_PASSPHRASE_FILE=/opt/flotilla/secrets/borg_passphrase
BORG_RSH="ssh -i /opt/flotilla/secrets/entourage_borg_ssh -o IdentitiesOnly=yes"

# Flotilla paths on Entourage.
FLOTILLA_BASE=/opt/flotilla
COMPOSE_FILE=/opt/flotilla/docker-compose.yml

# Today's application-specific backup target. Keep this here so the Borg
# plumbing can grow beyond Nextcloud without changing repository setup.
NEXTCLOUD_CONTAINER=nextcloud
POSTGRES_CONTAINER=postgres

# Compose secrets used by the Nextcloud database.
NEXTCLOUD_DB_FILE=/opt/flotilla/secrets/nextcloud_postgres_db
NEXTCLOUD_DB_USER_FILE=/opt/flotilla/secrets/nextcloud_postgres_user
NEXTCLOUD_DB_PASSWORD_FILE=/opt/flotilla/secrets/nextcloud_postgres_password
